# Codespaces Development Environment
# This file is used when running in GitHub Codespaces

# Backend will be dynamically set by startup script
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_VERSION=1.0.0
REACT_APP_GITHUB_URL=https://github.com/shreyanmitra/EasyMARL

# Development settings
GENERATE_SOURCEMAP=false
FAST_REFRESH=true
CHOKIDAR_USEPOLLING=false

# Browser settings for Codespaces
BROWSER=none
WDS_SOCKET_HOST=0.0.0.0
WDS_SOCKET_PORT=0
