# EasyMARL Codespaces Environment Configuration

# Flask Backend Settings
FLASK_ENV=development
FLASK_DEBUG=True
PYTHONPATH=/workspaces/EasyMARL

# React Frontend Settings (will be dynamically updated)
REACT_APP_API_URL=http://localhost:5000/api
REACT_APP_VERSION=1.0.0
REACT_APP_GITHUB_URL=https://github.com/shreyanmitra/EasyMARL

# CORS Settings (will be dynamically updated for Codespaces)
CORS_ORIGINS=http://localhost:3000,https://shreyanmitra.github.io

# Development Settings
USE_MOCK_DATA=False
ENABLE_TRAINING=True
DEBUG_MODE=True

# ML Settings
DEVICE=auto
ENABLE_GPU=True
TORCH_DEVICE=auto

# Training Settings
DEFAULT_EPISODES=100
DEFAULT_ALGORITHM=ippo
DEFAULT_ENVIRONMENT=MultiGrid-Cluttered-Fixed-15x15

# Logging Settings
LOG_LEVEL=INFO
WANDB_MODE=disabled
