{
  "name": "EasyMARL Demo (Read-Only)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "18"
    }
  },
  
  "forwardPorts": [5000, 3000],
  "portsAttributes": {
    "5000": {
      "label": "Flask Backend",
      "onAutoForward": "notify"
    },
    "3000": {
      "label": "React Demo App", 
      "onAutoForward": "openBrowser"
    }
  },
  
  "postStartCommand": "bash .devcontainer/readonly-startup.sh",
  
  "customizations": {
    "vscode": {
      "settings": {
        "files.readonlyInclude": {
          "**/*": true
        },
        "files.readonlyExclude": {
          "**/node_modules/**": false,
          "**/.git/**": false,
          "**/tmp/**": false,
          "**/logs/**": false
        },
        "explorer.confirmDelete": true,
        "explorer.confirmDragAndDrop": true,
        "git.enabled": false,
        "terminal.integrated.profiles.linux": {
          "bash (read-only)": {
            "path": "/bin/bash",
            "args": ["-c", "echo 'Welcome to EasyMARL Demo! This is a read-only environment.'; echo 'React app: http://localhost:3000'; echo 'Flask API: http://localhost:5000/api'; bash --login"]
          }
        },
        "terminal.integrated.defaultProfile.linux": "bash (read-only)"
      },
      "extensions": [
        "ms-python.python",
        "bradlc.vscode-tailwindcss",
        "esbenp.prettier-vscode"
      ]
    }
  },
  
  "containerEnv": {
    "DEMO_MODE": "true",
    "READ_ONLY": "true"
  }
}
