include README.md
include LICENSE
include requirements.txt
include pyproject.toml
include INTEGRATION_COMPLETE.md

# Configuration files
recursive-include config *.yaml

# Example scripts
recursive-include examples *.py

# GUI files
include gui.py
include main.py

# React frontend (if built)
recursive-include react-frontend/build *
recursive-include react-frontend/public *

# Documentation
recursive-include docs *

# Exclude development files
global-exclude __pycache__
global-exclude *.py[co]
global-exclude .git*
global-exclude .DS_Store
global-exclude *.so
global-exclude *.egg-info
prune venv
prune node_modules
prune outputs
prune .github
